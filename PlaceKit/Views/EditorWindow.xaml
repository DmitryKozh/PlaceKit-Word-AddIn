<Window x:Class="PlaceKit.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PlaceKit.Views"
        xmlns:vm="clr-namespace:PlaceKit.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
        Title="{Binding Title}"
        Width="600"
        Height="640"
        MinWidth="400"
        MinHeight="360"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary Source="/PlaceKit;component/Views/Theme.xaml" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="S" Command="{Binding SaveCommand}" Modifiers="Control" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <views:EditorView x:Name="Editor" />
</Window>
