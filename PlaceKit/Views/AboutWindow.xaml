<Window x:Class="PlaceKit.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:PlaceKit.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
        Title="{Binding Title}"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary Source="/PlaceKit;component/Views/Theme.xaml" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterStyle}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Command="{Binding CloseCommand}"
                        Content="Close"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Using it at work?" />
                    <Button Margin="4,0,0,0"
                            Command="{Binding AskForLicenseCommand}"
                            Content="Ask about a license"
                            Style="{StaticResource LinkButtonStyle}"
                            ToolTip="{Binding Product.ContactPage}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="{StaticResource DialogPadding}">
            <Border Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="14">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource CodeFontFamily}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="{}{ }" />
            </Border>

            <TextBlock Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Text="{Binding Product.Name}" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{Binding VersionText}" />
            <TextBlock Margin="0,16,0,0"
                       Text="{Binding Product.Description}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Border Height="1" Margin="0,24" Background="{StaticResource DividerBrush}" />

            <Border Padding="16"
                    Background="{StaticResource AccentSubtleBrush}"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Need a .NET developer?" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding Introduction}"
                               TextWrapping="Wrap" />
                    <ItemsControl Margin="0,12,0,-6" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagStyle}">
                                    <TextBlock Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <sys:String>C#</sys:String>
                        <sys:String>.NET</sys:String>
                        <sys:String>WPF</sys:String>
                        <sys:String>REST APIs</sys:String>
                        <sys:String>AI integration</sys:String>
                        <sys:String>SQL Server</sys:String>
                        <sys:String>VSTO add-ins</sys:String>
                        <sys:String>Excel and VBA</sys:String>
                    </ItemsControl>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ContactCommand}"
                                Content="Describe your problem"
                                Style="{StaticResource LinkButtonStyle}"
                                ToolTip="{Binding Product.ContactPage}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="The initial assessment is free." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,24,0,0" TextElement.FontSize="12">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Free for noncommercial use" />
                    <TextBlock Margin="6,0" Style="{StaticResource CaptionTextStyle}" Text="&#x00B7;" />
                    <Button Command="{Binding OpenLicenseCommand}"
                            Content="License terms"
                            Style="{StaticResource LinkButtonStyle}"
                            ToolTip="PolyForm Noncommercial License 1.0.0" />
                    <TextBlock Margin="6,0" Style="{StaticResource CaptionTextStyle}" Text="&#x00B7;" />
                    <Button Command="{Binding OpenNoticesCommand}"
                            Content="Third-party notices"
                            Style="{StaticResource LinkButtonStyle}"
                            ToolTip="The libraries PlaceKit uses and their licenses" />
                </StackPanel>
                <StackPanel Margin="0,4,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Product.Copyright}" />
                    <TextBlock Margin="6,0" Style="{StaticResource CaptionTextStyle}" Text="&#x00B7;" />
                    <Button Command="{Binding OpenWebsiteCommand}"
                            Content="{Binding WebsiteText}"
                            Style="{StaticResource LinkButtonStyle}"
                            ToolTip="{Binding Product.Website}" />
                    <TextBlock Margin="6,0" Style="{StaticResource CaptionTextStyle}" Text="&#x00B7;" />
                    <Button Command="{Binding OpenLinkedInCommand}"
                            Content="LinkedIn"
                            Style="{StaticResource LinkButtonStyle}"
                            ToolTip="{Binding Product.LinkedIn}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
