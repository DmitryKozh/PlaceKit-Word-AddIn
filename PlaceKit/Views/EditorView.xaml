<UserControl x:Class="PlaceKit.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PlaceKit.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="380"
             Background="{DynamicResource SurfaceBrush}"
             FontFamily="Segoe UI"
             FontSize="14"
             Foreground="{DynamicResource TextBrush}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlaceKit;component/Views/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MoveButtonStyle" BasedOn="{StaticResource IconButtonStyle}" TargetType="Button">
                <Setter Property="Content" Value="&#xE90D;" />
                <Setter Property="ToolTip" Value="Dock to the side panel" />
                <Setter Property="AutomationProperties.Name" Value="Dock to the side panel" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsInSidePanel}" Value="True">
                        <Setter Property="Content" Value="&#xE8A7;" />
                        <Setter Property="ToolTip" Value="Open in a separate window" />
                        <Setter Property="AutomationProperties.Name" Value="Open in a separate window" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="PlaceholderTemplate" DataType="vm:PlaceholderItemViewModel">
                <Border x:Name="Card"
                        Margin="4,0,4,4"
                        Padding="12,7,12,12"
                        Background="Transparent"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.RowSpan="2"
                                   Width="3"
                                   Margin="-8,0,0,0"
                                   HorizontalAlignment="Left"
                                   Fill="{StaticResource AccentBrush}"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   ToolTip="Modified, not saved yet"
                                   Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibility}}" />

                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource WarningBrush}"
                                   Style="{StaticResource IconTextStyle}"
                                   Text="&#xE7BA;"
                                   ToolTip="The occurrences of this placeholder hold different values. Saving writes this value to all of them."
                                   Visibility="{Binding HasMixedValues, Converter={StaticResource BooleanToVisibility}}" />

                        <Border Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="6,0,6,1"
                                VerticalAlignment="Center"
                                Background="{StaticResource ControlPressedBrush}"
                                CornerRadius="8"
                                ToolTip="{Binding UsageText}"
                                Visibility="{Binding IsUsedSeveralTimes, Converter={StaticResource BooleanToVisibility}}">
                            <TextBlock FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding Occurrences, StringFormat='{}{0} uses'}" />
                        </Border>

                        <!-- negative margins: the button must not make the row taller -->
                        <Button Grid.Column="3"
                                Width="24"
                                Height="24"
                                Margin="4,-4,-5,-4"
                                AutomationProperties.Name="Show in the document"
                                Command="{Binding DataContext.LocateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="&#xE890;"
                                FontSize="14"
                                IsTabStop="False"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Show in the document. Click again for the next occurrence." />

                        <TextBox Grid.Row="1"
                                 Grid.ColumnSpan="4"
                                 MaxHeight="240"
                                 Margin="0,6,0,0"
                                 AcceptsReturn="True"
                                 AutomationProperties.Name="{Binding Name}"
                                 Tag="Not filled in"
                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Border Padding="16,12" DockPanel.Dock="Bottom" Style="{StaticResource FooterStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding SaveCommand}"
                            Content="_Save"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Write the changed values to the document" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{Binding IsInWindow, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
                <TextBlock Margin="0,0,12,3"
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding Summary}" />
            </DockPanel>
        </Border>

        <Grid Margin="16,16,16,4" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Margin="-8,0,4,0" Command="{Binding MoveCommand}" Style="{StaticResource MoveButtonStyle}" />

            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         Padding="30,4,30,7"
                         AutomationProperties.Name="Search"
                         Tag="Search placeholders and values"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Margin="10,0,0,0"
                           HorizontalAlignment="Left"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           IsHitTestVisible="False"
                           Style="{StaticResource IconTextStyle}"
                           Text="&#xE721;" />
                <Button Width="24"
                        Height="24"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Clear the search"
                        Command="{Binding ClearSearchCommand}"
                        Content="&#xE711;"
                        FontSize="10"
                        IsTabStop="False"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="Clear the search (Esc)"
                        Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>

            <Button Grid.Column="2"
                    Margin="4,0,-8,0"
                    AutomationProperties.Name="Reload"
                    Command="{Binding RefreshCommand}"
                    Content="&#xE72C;"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTip="Reload the placeholders from the document. Unsaved values are kept."
                    Visibility="{Binding IsInSidePanel, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>

        <StackPanel Margin="8,0,16,8" DockPanel.Dock="Top" Orientation="Horizontal">
            <Button AutomationProperties.Name="Import"
                    Command="{Binding ImportCommand}"
                    Style="{StaticResource CommandButtonStyle}"
                    ToolTip="Fill in the placeholders from a values file. Nothing is written to the document until you save.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xE8B5;" />
                    <AccessText Style="{StaticResource CommandLabelStyle}" Text="_Import" />
                </StackPanel>
            </Button>
            <Button Margin="4,0,0,0"
                    AutomationProperties.Name="Export"
                    Command="{Binding ExportCommand}"
                    Style="{StaticResource CommandButtonStyle}"
                    ToolTip="Save the filled-in values to a file, to reuse them in other documents.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextStyle}" Text="&#xEDE1;" />
                    <AccessText Style="{StaticResource CommandLabelStyle}" Text="_Export" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid>
            <ItemsControl Focusable="False"
                          ItemTemplate="{StaticResource PlaceholderTemplate}"
                          ItemsSource="{Binding ItemsView}"
                          KeyboardNavigation.TabNavigation="Continue"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Style="{StaticResource OverlayScrollViewerStyle}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter Margin="0,0,0,8" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="28"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Style="{StaticResource IconTextStyle}"
                           Text="&#xE8A5;" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="No placeholders in this document" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="Click Create on the PlaceKit tab to turn marked text into placeholders."
                           TextAlignment="Center" />
            </StackPanel>

            <TextBlock Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="No placeholders match your search."
                       TextAlignment="Center"
                       Visibility="{Binding HasNoMatches, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
