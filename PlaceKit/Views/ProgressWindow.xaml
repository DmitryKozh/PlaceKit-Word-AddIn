<Window x:Class="PlaceKit.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PlaceKit.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ProgressViewModel}"
        Title="PlaceKit"
        Width="440"
        Height="176"
        SizeToContent="Manual"
        ShowActivated="False"
        Topmost="True"
        Style="{DynamicResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary Source="/PlaceKit;component/Views/Theme.xaml" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />

        <ProgressBar Grid.Row="1"
                     Height="4"
                     Margin="0,16,0,0"
                     Background="{StaticResource DividerBrush}"
                     BorderThickness="0"
                     Foreground="{StaticResource AccentBrush}"
                     IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                     Maximum="{Binding Total, Mode=OneWay}"
                     Value="{Binding Current, Mode=OneWay}" />

        <DockPanel Grid.Row="2" VerticalAlignment="Bottom">
            <Button Command="{Binding CancelCommand}"
                    Content="Cancel"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <TextBlock Margin="0,0,12,3"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}"
                       Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</Window>
