<Window x:Class="PlaceKit.Views.CreateSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PlaceKit.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CreateSummaryViewModel}"
        Title="{Binding Title}"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary Source="/PlaceKit;component/Views/Theme.xaml" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding NotNowCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterStyle}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding OpenEditorCommand}"
                        Content="_Open editor"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Margin="8,0,0,0"
                        Command="{Binding NotNowCommand}"
                        Content="_Not now"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>

        <Grid Margin="{StaticResource DialogPadding}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Width="40"
                    Height="40"
                    Margin="0,0,16,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentSubtleBrush}"
                    CornerRadius="20">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="18"
                           Foreground="{StaticResource AccentBrush}"
                           Style="{StaticResource IconTextStyle}"
                           Text="&#xE73E;" />
            </Border>

            <StackPanel Grid.Column="1" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource TitleTextStyle}" Text="{Binding Headline}" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding SkippedText}"
                           Visibility="{Binding HasSkipped, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Margin="0,12,0,0"
                           Text="Would you like to open the editor and fill them in now?"
                           TextWrapping="Wrap" />
                <CheckBox Margin="0,16,0,0"
                          Content="_Don't ask again, remember my choice"
                          IsChecked="{Binding RememberChoice}" />
                <TextBlock Margin="24,2,0,0" Style="{StaticResource CaptionTextStyle}" Text="You can change this later in Settings." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
