<Window x:Class="PlaceKit.Views.AiSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tools="clr-namespace:PlaceKit.Tools"
        xmlns:vm="clr-namespace:PlaceKit.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AiSetupViewModel}"
        Title="{Binding Title}"
        Width="520"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=ApiKeyBox}"
        Style="{DynamicResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlaceKit;component/Views/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The step's number in a circle, its first line level with the step's heading -->
            <Style x:Key="StepNumberStyle" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="StepNumberTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>

            <Style x:Key="StepHeadingStyle" BasedOn="{StaticResource SectionTextStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding NotNowCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterStyle}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Command="{Binding ConnectCommand}"
                        Content="_Connect"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="Test the key, then save it" />
                <Button Margin="8,0,0,0"
                        Command="{Binding NotNowCommand}"
                        Content="_Not now"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="{StaticResource DialogPadding}">
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding Intro}" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepNumberStyle}">
                    <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="1" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource StepHeadingStyle}" Text="Choose the service" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="C_laude by Anthropic" GroupName="AiProvider" IsChecked="{Binding UseClaude}" />
                        <RadioButton Margin="24,0,0,0"
                                     Content="Chat_GPT by OpenAI"
                                     GroupName="AiProvider"
                                     IsChecked="{Binding UseOpenAI}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepNumberStyle}">
                    <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="2" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource StepHeadingStyle}" Text="Get an API key" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding KeySteps}" />
                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenKeysPageCommand}"
                            Content="{Binding KeysPageLink}"
                            Style="{StaticResource LinkButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource StepNumberStyle}">
                    <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="3" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource StepHeadingStyle}" Text="Paste the key" />
                    <PasswordBox x:Name="ApiKeyBox"
                                 AutomationProperties.Name="API key"
                                 Tag="{Binding ApiKeyHint}"
                                 tools:PasswordBoxBinding.Password="{Binding NewApiKey, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,3,8,0"
                                   VerticalAlignment="Top"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Style="{StaticResource IconTextStyle}"
                                   Text="&#xEA39;" />
                        <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,24,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding PrivacyNote}" />
        </StackPanel>
    </DockPanel>
</Window>
