<Window x:Class="PlaceKit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tools="clr-namespace:PlaceKit.Tools"
        xmlns:vm="clr-namespace:PlaceKit.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{Binding Title}"
        Width="720"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=OpeningMarkerBox}"
        Style="{DynamicResource DialogWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PlaceKit;component/Views/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="GeneralPageStyle" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowGeneralPage}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="AiPageStyle" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowAiPage}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UpdatesPageStyle" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowUpdatesPage}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ConnectionIconStyle" BasedOn="{StaticResource IconTextStyle}" TargetType="TextBlock">
                <Setter Property="Text" Value="&#xEA39;" />
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Text" Value="&#xE73E;" />
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="UpdateCheckIconStyle" BasedOn="{StaticResource IconTextStyle}" TargetType="TextBlock">
                <Setter Property="Text" Value="&#xEA39;" />
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUpToDate}" Value="True">
                        <Setter Property="Text" Value="&#xE73E;" />
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="Tab" Command="{Binding NextPageCommand}" Modifiers="Control" />
        <KeyBinding Key="Tab" Command="{Binding PreviousPageCommand}" Modifiers="Control+Shift" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding SaveCommand}"
                            Content="_Save"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Margin="8,0,0,0"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
                <Button HorizontalAlignment="Left"
                        Command="{Binding ResetCommand}"
                        Content="_Reset to defaults"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </DockPanel>
        </Border>

        <!-- Pages are Hidden, not Collapsed, so the window keeps the taller one's height -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="8,16">
                    <RadioButton Content="General"
                                 GroupName="Page"
                                 IsChecked="{Binding ShowGeneralPage}"
                                 Style="{StaticResource NavigationItemStyle}"
                                 Tag="&#xE713;" />
                    <RadioButton Margin="0,4,0,0"
                                 Content="AI"
                                 GroupName="Page"
                                 IsChecked="{Binding ShowAiPage}"
                                 Style="{StaticResource NavigationItemStyle}"
                                 Tag="&#xE82F;" />
                    <RadioButton Margin="0,4,0,0"
                                 Content="Updates"
                                 GroupName="Page"
                                 IsChecked="{Binding ShowUpdatesPage}"
                                 Style="{StaticResource NavigationItemStyle}"
                                 Tag="&#xE895;" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <StackPanel Margin="{StaticResource DialogPadding}" Style="{StaticResource GeneralPageStyle}">
                    <TextBlock Style="{StaticResource SectionTextStyle}" Text="Placeholder pattern" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Text between these markers becomes a placeholder when you click Create." />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <!-- monospace text is already centred, symmetric padding -->
                        <StackPanel>
                            <Label Content="_Opening marker" Target="{Binding ElementName=OpeningMarkerBox}" />
                            <TextBox x:Name="OpeningMarkerBox"
                                     Padding="6,5"
                                     FontFamily="{StaticResource CodeFontFamily}"
                                     MaxLength="10"
                                     Text="{Binding OpeningMarker, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding (Validation.Errors)/ErrorContent, ElementName=OpeningMarkerBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="_Closing marker" Target="{Binding ElementName=ClosingMarkerBox}" />
                            <TextBox x:Name="ClosingMarkerBox"
                                     Padding="6,5"
                                     FontFamily="{StaticResource CodeFontFamily}"
                                     MaxLength="10"
                                     Text="{Binding ClosingMarker, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
                            <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding (Validation.Errors)/ErrorContent, ElementName=ClosingMarkerBox}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,8,0,0"
                            Padding="12,7,12,9"
                            Background="{StaticResource AccentSubtleBrush}"
                            CornerRadius="4">
                        <TextBlock>
                            <Run Foreground="{StaticResource SecondaryTextBrush}" Text="Example:" />
                            <Run FontFamily="{StaticResource CodeFontFamily}" Text="{Binding Preview, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <TextBlock Margin="0,24,0,4" Style="{StaticResource SectionTextStyle}" Text="After creating placeholders" />
                    <CheckBox Content="Show a _summary and ask whether to open the editor" IsChecked="{Binding ShowCreateSummary}" />
                    <CheckBox Margin="24,10,0,0"
                              Content="Open the _editor automatically"
                              IsChecked="{Binding OpenEditorAfterCreate}"
                              IsEnabled="{Binding CanChooseAutoOpen}" />

                    <TextBlock Margin="0,24,0,4" Style="{StaticResource SectionTextStyle}" Text="Open the editor in" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Side _panel next to the document" GroupName="EditorPlacement" IsChecked="{Binding OpenInSidePanel}" />
                        <RadioButton Margin="24,0,0,0"
                                     Content="Separate _window"
                                     GroupName="EditorPlacement"
                                     IsChecked="{Binding OpenInWindow}" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" Text="The button in the editor's top-left corner moves it between the two." />

                    <TextBlock Margin="0,24,0,4" Style="{StaticResource SectionTextStyle}" Text="When finalizing" />
                    <CheckBox Content="_Ask what to do with placeholders that are not filled in" IsChecked="{Binding AskAboutEmptyPlaceholders}" />
                    <StackPanel Margin="24,10,0,0" Orientation="Horizontal">
                        <RadioButton Content="Turn them back into _markers"
                                     GroupName="EmptyPlaceholders"
                                     IsChecked="{Binding KeepEmptyPlaceholdersAsMarkers}"
                                     IsEnabled="{Binding CanChooseEmptyPlaceholderAction}" />
                        <RadioButton Margin="24,0,0,0"
                                     Content="_Delete them from the text"
                                     GroupName="EmptyPlaceholders"
                                     IsChecked="{Binding DeleteEmptyPlaceholders}"
                                     IsEnabled="{Binding CanChooseEmptyPlaceholderAction}" />
                    </StackPanel>

                    <TextBlock Margin="0,24,0,0" Style="{StaticResource CaptionTextStyle}">
                        <Run Text="Stored in" />
                        <Run FontFamily="{StaticResource CodeFontFamily}" Text="{Binding StorageLocation, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Margin="{StaticResource DialogPadding}" Style="{StaticResource AiPageStyle}">
                    <TextBlock Style="{StaticResource SectionTextStyle}" Text="AI service" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="From text finds placeholder values in a text you paste, and Detect finds the parts of a document that should become placeholders. Both use an AI service with your own API key." />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <RadioButton Content="_Claude by Anthropic" GroupName="AiProvider" IsChecked="{Binding UseClaude}" />
                        <RadioButton Margin="24,0,0,0"
                                     Content="Chat_GPT by OpenAI"
                                     GroupName="AiProvider"
                                     IsChecked="{Binding UseOpenAI}" />
                    </StackPanel>

                    <Label Margin="0,16,0,0" Content="{Binding ApiKeyLabel}" Target="{Binding ElementName=ApiKeyBox}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox" Tag="{Binding ApiKeyHint}" tools:PasswordBoxBinding.Password="{Binding NewApiKey, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding RemoveApiKeyCommand}"
                                Content="Remove"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="Delete the saved key when you save the settings"
                                Visibility="{Binding HasSavedApiKey, Converter={StaticResource BooleanToVisibility}}" />
                    </Grid>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}">
                        <Run Text="Saved encrypted for your Windows account." />
                        <Hyperlink Command="{Binding OpenApiKeysPageCommand}" Foreground="{StaticResource AccentBrush}">
                            <Run Text="{Binding ApiKeysPageLink, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button VerticalAlignment="Top"
                                Command="{Binding TestConnectionCommand}"
                                Content="_Test connection"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Grid Grid.Column="1"
                              Margin="12,6,0,0"
                              VerticalAlignment="Top"
                              Visibility="{Binding HasConnectionMessage, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,3,8,0" VerticalAlignment="Top" Style="{StaticResource ConnectionIconStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding ConnectionMessage}" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>

                    <TextBlock Margin="0,24,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding PrivacyNote}" />
                </StackPanel>

                <StackPanel Margin="{StaticResource DialogPadding}" Style="{StaticResource UpdatesPageStyle}">
                    <TextBlock Style="{StaticResource SectionTextStyle}" Text="Updates" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding InstalledVersion}" />
                    <CheckBox Margin="0,12,0,0" Content="Check for _updates when Word starts" IsChecked="{Binding CheckForUpdates}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CheckNowButton"
                                VerticalAlignment="Top"
                                Command="{Binding CheckNowCommand}"
                                Content="Check _now"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        <Grid Grid.Column="1"
                              Margin="12,6,0,0"
                              VerticalAlignment="Top"
                              Visibility="{Binding HasUpdateCheckMessage, Converter={StaticResource BooleanToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,3,8,0" VerticalAlignment="Top" Style="{StaticResource UpdateCheckIconStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdateCheckMessage}" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>

                    <Border Margin="0,16,0,0"
                            Padding="16"
                            Background="{StaticResource AccentSubtleBrush}"
                            CornerRadius="4"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding UpdateHeading}" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="Download the installer, close Word and run it. Your settings and API keys stay." />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button x:Name="DownloadButton"
                                        Command="{Binding DownloadUpdateCommand}"
                                        Content="_Download"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenReleaseNotesCommand}"
                                        Content="What's new"
                                        Style="{StaticResource LinkButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,24,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding UpdatePrivacyNote}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
