<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- The pages of WixUI: Welcome, Ready to install and the progress, then FinishDlg, which says what Setup did and can start Word.
       Run again when PlaceKit is installed, it offers Repair and Remove. The texts are in SetupWizard.wxl. -->
  <Fragment>
    <UI Id="SetupWizard">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="WelcomeDlg" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- In place of WixUI's ExitDialog, whose check box is grey on the white page: this one has it in the footer. -->
      <Dialog Id="FinishDlg" Width="370" Height="270" Title="!(loc.ExitDialog_Title)">
        <Control Id="Finish" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIFinish)">
          <Publish Event="DoAction" Value="StartWord" Condition="STARTWORD = 1 AND WORDEXE AND NOT Installed" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="StartWord" Type="CheckBox" X="135" Y="243" Width="90" Height="17" Hidden="yes" Property="STARTWORD" CheckBoxValue="1" Text="!(loc.SetupWizardStartWord)" ShowCondition="WORDEXE AND NOT Installed" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Disabled="yes" Text="!(loc.WixUICancel)" />
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="!(loc.ExitDialogBitmap)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="InstalledTitle" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.SetupWizardInstalledTitle)" ShowCondition="NOT Installed" />
        <Control Id="RepairedTitle" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.SetupWizardRepairedTitle)" ShowCondition="Installed AND WixUI_InstallMode = &quot;Repair&quot;" />
        <Control Id="RemovedTitle" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.SetupWizardRemovedTitle)" ShowCondition="Installed AND WixUI_InstallMode = &quot;Remove&quot;" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.ExitDialogTitle)" ShowCondition="Installed AND WixUI_InstallMode &lt;&gt; &quot;Repair&quot; AND WixUI_InstallMode &lt;&gt; &quot;Remove&quot;" />
        <Control Id="WhereText" Type="Text" X="135" Y="80" Width="220" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.SetupWizardWhere)" ShowCondition="NOT Installed" />
        <Control Id="RestartText" Type="Text" X="135" Y="105" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.SetupWizardRestart)" ShowCondition="NOT Installed" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="!(loc.ExitDialogDescription)" ShowCondition="Installed" />
      </Dialog>

      <InstallUISequence>
        <Show Dialog="FinishDlg" OnExit="success" />
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="FinishDlg" OnExit="success" />
      </AdminUISequence>
    </UI>

    <UIRef Id="WixUI_Common" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />

    <!-- Start Word, checked, when Word is there. -->
    <Property Id="STARTWORD" Value="1" />
    <Property Id="WORDEXE">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\Winword.exe" Type="raw" Bitness="always64" />
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\Winword.exe" Type="raw" Bitness="always32" />
    </Property>

    <!-- By name, which the shell looks up in App Paths: this 32-bit package reads C:\Program Files in WORDEXE as
         C:\Program Files (x86), where 64-bit Office is not. -->
    <Property Id="WixShellExecTarget" Value="winword.exe" />
    <CustomAction Id="StartWord" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Fragment>
</Wix>
